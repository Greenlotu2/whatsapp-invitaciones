# Copia este archivo como .env y llena los valores (ver README.md)

# --- Meta / WhatsApp Cloud API ---
# Token de acceso permanente (Usuario del sistema en Business Manager)
WHATSAPP_TOKEN=
# ID del número de teléfono (WhatsApp > Configuración de la API)
WHATSAPP_PHONE_NUMBER_ID=
# Versión de la Graph API
GRAPH_API_VERSION=v25.0
# Clave secreta de la app (Configuración de la app > Básica). Valida la firma del webhook.
META_APP_SECRET=
# Texto libre que inventas tú; lo pegas igual en Meta al configurar el webhook
WEBHOOK_VERIFY_TOKEN=

# --- Plantilla aprobada ---
TEMPLATE_NAME=recordatorio_evento_v3
TEMPLATE_LANG=es_MX
# Zona horaria de los eventos (para el botón de calendario)
EVENT_TIMEZONE=America/Mexico_City

# --- App ---
PORT=3000
# Lada que se antepone a números de 10 dígitos (52 = México)
DEFAULT_COUNTRY_CODE=52
# Contraseña del panel (usuario: admin). Vacío = sin contraseña (solo para pruebas locales)
ADMIN_PASSWORD=
# Mensaje automático cuando la persona responde (vacío = no responder)
REPLY_CONFIRMADO=¡Gracias por confirmar! Te esperamos. Agrega el evento a tu calendario para no olvidarlo.
REPLY_RECHAZADO=Gracias por avisarnos. ¡Será en otra ocasión!
